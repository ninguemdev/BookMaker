{
  "name": "bookmaker",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:rust": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all -- --check",
    "typecheck": "corepack pnpm --recursive --if-present typecheck",
    "test": "corepack pnpm --recursive --if-present test",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.0"
  }
}
